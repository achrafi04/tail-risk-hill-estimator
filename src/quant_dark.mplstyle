figure.facecolor: 0e0e10
axes.facecolor: 0e0e10
savefig.facecolor: 0e0e10

axes.edgecolor: 3a3a3d
axes.labelcolor: d4d4d8
axes.titlecolor: f5f5f5
axes.grid: True
grid.color: 26262a
grid.linewidth: 0.6
grid.alpha: 0.6

axes.prop_cycle: cycler('color', ['e8a33d', '4fb8a8', 'd4634a', '7b91d1', 'c9c9cd'])

xtick.color: a1a1a6
ytick.color: a1a1a6
text.color: d4d4d8

font.family: monospace
font.size: 10

lines.linewidth: 1.2
lines.solid_capstyle: round

legend.facecolor: 18181b
legend.edgecolor: 3a3a3d
legend.labelcolor: d4d4d8

figure.figsize: 10, 5
savefig.dpi: 150
savefig.bbox: tight